{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "TraceForge Desktop",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "active": true,
      "targets": "all",
      "identifier": "com.traceforge.desktop",
      "publisher": "Chen Jianjun",
      "copyright": "Copyright © 2025 C2J. All rights reserved.",
      "category": "DeveloperTool",
      "shortDescription": "TraceForge Desktop, A Tauri + React application for testing automation",
      "longDescription": "This is a starter template for building Tauri applications with React and TypeScript."
    },
    "allowlist": {
      "all": true,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "copyFile": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true,
        "exists": true,
        "scope": ["**"]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "window": {
        "all": true,
        "create": true,
        "close": true,
        "setAlwaysOnTop": true,
        "setTitle": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "setFullscreen": true,
        "setIcon": true
      },
      "process": {
        "all": true,
        "exit": true,
        "relaunch": true
      }
    },
    "windows": [
      {
        "title": "TraceForge Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src http://localhost:* ws://localhost:*;"
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist"
  }
}
